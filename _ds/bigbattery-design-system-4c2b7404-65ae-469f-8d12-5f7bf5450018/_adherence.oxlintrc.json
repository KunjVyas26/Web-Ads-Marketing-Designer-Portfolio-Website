{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "deals/**",
              "off-grid/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--bb-accent",
      "--bb-accent-soft",
      "--bb-amber",
      "--bb-blue",
      "--bb-blue-700",
      "--bb-blue-dark",
      "--bb-green",
      "--bb-green-bright",
      "--bb-green-deep",
      "--bb-navy",
      "--bb-navy-2",
      "--bb-sale",
      "--bb-sale-dark",
      "--ease",
      "--font",
      "--ink",
      "--ink-2",
      "--line",
      "--line-2",
      "--maxw",
      "--muted",
      "--page",
      "--r-lg",
      "--r-md",
      "--r-sm",
      "--r-xl",
      "--shadow-lg",
      "--shadow-md",
      "--shadow-sm",
      "--surface",
      "--surface-2",
      "--surface-3"
    ],
    "tokenKinds": {
      "--bb-blue": "color",
      "--bb-blue-dark": "color",
      "--bb-blue-700": "color",
      "--bb-navy": "color",
      "--bb-navy-2": "color",
      "--bb-green": "color",
      "--bb-green-deep": "color",
      "--bb-green-bright": "color",
      "--bb-sale": "color",
      "--bb-sale-dark": "color",
      "--bb-accent": "color",
      "--bb-accent-soft": "color",
      "--bb-amber": "color",
      "--ink": "color",
      "--ink-2": "color",
      "--muted": "color",
      "--line": "color",
      "--line-2": "color",
      "--surface": "color",
      "--surface-2": "color",
      "--surface-3": "color",
      "--page": "color",
      "--r-sm": "spacing",
      "--r-md": "spacing",
      "--r-lg": "spacing",
      "--r-xl": "spacing",
      "--shadow-sm": "shadow",
      "--shadow-md": "shadow",
      "--shadow-lg": "shadow",
      "--ease": "other",
      "--maxw": "spacing",
      "--font": "font"
    },
    "fontFamilies": []
  }
}